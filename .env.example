# ============================================================
# Paper Agent - Environment Configuration
# ============================================================
#
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 取消注释你选择的方案（A / B 之一）
#   3. 将 ************************ 替换为你的真实 API Key
#   4. 切勿分享 .env 文件，切勿提交到 git
#
# ============================================================

# --------------------------------------------------
# 方案 A：DeepSeek 官方 API（推荐）+ 多模态大模型
# 申请地址：https://platform.deepseek.com/
# --------------------------------------------------
# DEEPSEEK_API_KEY=sk-************************
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_LIGHT=deepseek-v4-flash
# DEEPSEEK_MODEL_REASONING=deepseek-v4-flash

# MULTIMODAL VISION MODEL (optional, OpenAI-compatible) — 扫描/混合 PDF OCR 
# 注意：DeepSeek 官方 API 无视觉模型，此 key 需另选视觉端点。

# MULTIMODAL_BASE_URL=
# MULTIMODAL_API_KEY=
# MULTIMODAL_MODEL=

# --------------------------------------------------
# 方案 B：其他 OpenAI 兼容平台
# 填入对应平台的 key、地址、模型名即可
# 例如 OpenRouter、SiliconFlow、Together AI 等
# --------------------------------------------------
# DEEPSEEK_API_KEY=************************
# DEEPSEEK_BASE_URL=https://your-platform.com/v1
# DEEPSEEK_MODEL_LIGHT=your-model-name
# DEEPSEEK_MODEL_REASONING=your-model-name

# ============================================================
# 多模态（视觉）模型 — 论文图/表/公式理解 + 扫描页 OCR（可选）
# 任意 OpenAI 兼容的视觉端点均可。留空则禁用视觉，系统回退纯文本。
# 与上面的文本 LLM 完全独立，互不影响。
# ============================================================
# MULTIMODAL_BASE_URL=https://www.cctq.ai/v1
# MULTIMODAL_API_KEY=sk-************************
# MULTIMODAL_MODEL=gpt-5.6-luna


# --------------------------------------------------
# 网络代理（可选）
# 如果访问学术 API（OpenAlex / arXiv / Semantic Scholar）有网络问题
# 取消注释并填入你的代理地址
# --------------------------------------------------
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# --------------------------------------------------
# 搜索设置（可选，有默认值）
# --------------------------------------------------
# DEFAULT_RESULTS_PER_SOURCE=20
# DEDUP_SIMILARITY_THRESHOLD=0.95

# --------------------------------------------------
# 学术 API 限流保护（可选，强烈推荐填写）
# --------------------------------------------------
# Semantic Scholar API Key（免费申请：https://www.semanticscholar.org/product/api#api-key）
# 未认证请求与其他用户共享公共额度，繁忙时可能持续返回 429；官方当前给新 Key 的起始额度为 1 req/s。
# S2_API_KEY=************************

# OpenAlex 联系邮箱（无需注册，填真实邮箱即可进入 polite pool）
# 填写后限流更宽松、响应更快
# OPENALEX_EMAIL=your-email@example.com

# --------------------------------------------------
# 全学科公开数据源（D-083，可选但推荐）
# 这些源免费、合法、公开、无需认证，覆盖人文/社科/医学/工程，弥补 arXiv 偏 CS 的不足
# 仅使用合法公开无认证 API，不含爬虫/校园 IP/cookie/EZproxy/无公开 API 的鉴权源
# --------------------------------------------------
# Crossref 联系邮箱（可选，复用 OPENALEX_EMAIL 亦可进入 polite pool）
# CROSSREF_EMAIL=your-email@example.com

# CORE API Key（免费申请：https://core.ac.uk/services/api）
# 配置后启用 CORE 仓储聚合源（2 亿+ OA 记录，社科人文机构库副本多）；不配置自动跳过
# CORE_API_KEY=************************

# ============================================================
# 安全提醒：
# - .env 文件包含你的 API Key，切勿分享
# - .gitignore 已排除 .env，不会被提交到 git
# - 如通过 ZIP 分享项目，务必排除：
#   zip -r project.zip project/ -x "*.env" "*.key"
# ============================================================

# ============================================================
# 运行与公网地址（生产部署必填；本地开发可保留默认）
# ============================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_HOST=127.0.0.1
# APP_PORT=8000
# 对外 HTTPS Origin，不带 /v1。清小搭附件下载 URL 以此为准。
# PUBLIC_BASE_URL=https://paper-agent.example.com

# ============================================================
# OpenAI 兼容端点（清小搭，DESIGN D-064）
# ============================================================
# 推荐由管理员运行 scripts/create_agent_api_key.py 或在管理页面创建长期
# pa_live_... 密钥；数据库仅保存哈希。下面的环境变量只作为迁移/应急凭证。
# 本地模式留空时接受任意非空 Bearer；生产模式没有数据库密钥或应急密钥时
# /v1 返回 503，错误/已撤销密钥返回 401。
# AGENT_API_KEY=replace-with-an-emergency-agent-key

# ============================================================
# 安全 / CORS（详见 DESIGN D-089）
# ============================================================
# 后端默认绑定 0.0.0.0；公网部署应改为 APP_HOST=127.0.0.1，仅由 nginx 暴露。
# CORS 始终使用显式白名单。单域名部署可填同一个 HTTPS Origin；两子域部署
# 必须将前端 Origin 加入 FRONTEND_ORIGIN/CORS_ORIGINS。
# FRONTEND_ORIGIN=https://paper-agent.example.com
# CORS_ORIGINS=https://paper-web.example.com

# ============================================================
# 多用户账号体系（自有前端）
# ============================================================
# 本地默认关闭，保持零配置单用户模式。生产推荐三项同时设置：
# AUTH_REQUIRED=true
# REGISTRATION_OPEN=false
# GUEST_ACCESS=false
# GUEST_ACCESS=true 时，未登录浏览器使用 X-Guest-Id 获得隔离游客身份。
# 清小搭 /v1 不使用浏览器账号令牌，只使用独立 Agent API Key。
# 管理员通过 scripts/bootstrap_administrator.py 交互式初始化；不要把管理员
# 密码写入 .env、命令行、文档或日志。
#
# 注意：以上四个开关（含下方 EMAIL_REQUIREMENT）只在首次运行时作为初始值
# 写入 data/users.db 的运行时设置行；之后以管理页 /admin/auth-settings 的
# 修改为准，改 .env 不再影响线上值。
# EMAIL_REQUIREMENT=none   # none=不要求邮箱 / collect=仅收集 / verify=强制验证码
# 误关账号登录后可在服务器执行 scripts/enable_auth_required.py 恢复。

# ============================================================
# SMTP 发信（注册邮箱验证码；verify 模式必需）
# ============================================================
# 凭据只保存在本文件，绝不写入数据库、日志或 API 响应。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl        # ssl（465 隐式 TLS）或 starttls（587）
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_SENDER=noreply@example.com   # 发件人地址，缺省回退到 SMTP_USERNAME
# SMTP_FROM_NAME=Paper Agent

# ============================================================
# 本地模型缓存（生产可选）
# ============================================================
# 先以服务账号真实加载 embedding/reranker/Docling，再启用离线模式。
# HF_HUB_OFFLINE=1
# XDG_CACHE_HOME=/var/lib/paper-agent/cache

# ============================================================
# 清小搭 / OpenAI API 独立存储（仅 /v1；不影响自制前端数据）
# ============================================================
# 默认：项目目录 data/openai_api。生产可改为同机受限目录。
# OPENAI_API_STORAGE_ROOT=/opt/paper-agent/data/openai_api
# 首次建库使用的策略预设；数据库初始化后以管理员保存的策略为准。
# 可选：privacy / balanced / performance（默认 balanced）
# OPENAI_API_POLICY_PRESET=balanced
